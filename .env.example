# =====================================================================
# Pollwise — Environment Configuration Reference (.env.example)
# NEVER commit populated production secrets or keys to version control.
# =====================================================================

# Environment mode: development | testing | staging | production
APP_ENV=development

# Database connection URLs (Logical DB isolation per ADR-001)
IDENTITY_DATABASE_URL=postgresql+asyncpg://identity_user:identity_pass@localhost:5433/identity_db
ELECTION_DATABASE_URL=postgresql+asyncpg://election_user:election_pass@localhost:5433/election_db
BALLOT_DATABASE_URL=postgresql+asyncpg://ballot_user:ballot_pass@localhost:5433/ballot_db

# Read-only ballot DB access for post-close tallying
BALLOT_DATABASE_RO_URL=postgresql+asyncpg://tally_ro_user:tally_ro_pass@localhost:5433/ballot_db

# Session and cookie management
SESSION_SECRET=replace-with-a-strong-random-secret-min-32-chars
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Origins and networking
FRONTEND_ORIGIN=http://localhost:5173
BALLOT_BOX_BASE_URL=http://localhost:8000/ballot-box/v1

# Service tokens and HMAC keys
BALLOT_BOX_SERVICE_TOKEN=pollwise-internal-ballot-box-token
CREDENTIAL_HMAC_KEY=pollwise-ballot-box-hmac-key

# Operational configurations
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10
RATE_LIMIT_LOGIN_PER_MIN=10
EMAIL_PROVIDER_API_KEY=
